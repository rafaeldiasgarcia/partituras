    {
      "name": "Listar partituras - sucesso",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const unique = Date.now().toString();",
              "const payload = {",
              "    titulo: `Lista Partitura ${unique}`,",
              "    compositor: `Compositor ${unique}`,",
              "    instrumento: 'Violino',",
              "    nivel: 'INICIANTE',",
              "    tom: 'G',",
              "    arquivoUrl: `https://exemplo.com/lista-${unique}.pdf`,",
              "    observacoes: `Gerada para listagem ${unique}`",
              "};",
              "",
              "pm.sendRequest({",
              "    url: `${pm.collectionVariables.get('baseUrl')}/partituras`,",
              "    method: 'POST',",
              "    header: { 'Content-Type': 'application/json' },",
              "    body: { mode: 'raw', raw: JSON.stringify(payload) }",
              "}, function (err, res) {",
              "    if (err) {",
              "        throw err;",
              "    }",
              "",
              "    const json = res.json();",
              "    pm.variables.set('partituraIdListagem', json.id);",
              "    pm.variables.set('tituloListagem', payload.titulo);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "const id = pm.variables.get('partituraIdListagem');",
              "const titulo = pm.variables.get('tituloListagem');",
              "const item = json.find(partitura => partitura.id === id);",
              "",
              "pm.test('Retorna array', function () {",
              "    pm.expect(json).to.be.an('array');",
              "});",
              "",
              "pm.test('Contém partitura criada no pre-request', function () {",
              "    pm.expect(item).to.exist;",
              "    pm.expect(item.titulo).to.eql(titulo);",
              "});"
            ]
          }
        }
      ],
