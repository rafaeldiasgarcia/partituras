      "name": "Atualizar partitura - sucesso",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const unique = Date.now().toString();",
              "const createPayload = {",
              "    titulo: `Atualizar Base ${unique}`,",
              "    compositor: `Chopin ${unique}`,",
              "    instrumento: 'Piano',",
              "    nivel: 'INICIANTE',",
              "    tom: 'A',",
              "    arquivoUrl: `https://exemplo.com/atualizar-base-${unique}.pdf`,",
              "    observacoes: `Base ${unique}`",
              "};",
              "",
              "pm.variables.set('tituloAtualizado', `Atualizada ${unique}`);",
              "pm.variables.set('compositorAtualizado', `Chopin Revisado ${unique}`);",
              "pm.variables.set('instrumentoAtualizado', 'Teclado');",
              "pm.variables.set('nivelAtualizado', 'AVANCADO');",
              "pm.variables.set('tomAtualizado', 'E');",
              "pm.variables.set('arquivoUrlAtualizado', `https://exemplo.com/atualizada-${unique}.pdf`);",
              "pm.variables.set('observacoesAtualizada', `Observação atualizada ${unique}`);",
              "",
              "pm.sendRequest({",
              "    url: `${pm.collectionVariables.get('baseUrl')}/partituras`,",
              "    method: 'POST',",
              "    header: { 'Content-Type': 'application/json' },",
              "    body: { mode: 'raw', raw: JSON.stringify(createPayload) }",
              "}, function (err, res) {",
              "    if (err) {",
              "        throw err;",
              "    }",
              "",
              "    const json = res.json();",
              "    pm.variables.set('partituraIdAtualizacao', json.id);",
              "    pm.variables.set('criadoEmOriginalAtualizacao', json.criadoEm);",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Retorna dados atualizados', function () {",
              "    pm.expect(json.id).to.eql(pm.variables.get('partituraIdAtualizacao'));",
              "    pm.expect(json.titulo).to.eql(pm.variables.get('tituloAtualizado'));",
              "    pm.expect(json.compositor).to.eql(pm.variables.get('compositorAtualizado'));",
              "    pm.expect(json.instrumento).to.eql(pm.variables.get('instrumentoAtualizado'));",
              "    pm.expect(json.nivel).to.eql(pm.variables.get('nivelAtualizado'));",
              "    pm.expect(json.tom).to.eql(pm.variables.get('tomAtualizado'));",
              "    pm.expect(json.arquivoUrl).to.eql(pm.variables.get('arquivoUrlAtualizado'));",
              "    pm.expect(json.observacoes).to.eql(pm.variables.get('observacoesAtualizada'));",
              "});",
              "",
              "pm.test('Mantém criadoEm e atualiza atualizadoEm', function () {",
              "    const criadoEmOriginal = new Date(pm.variables.get('criadoEmOriginalAtualizacao')).getTime();",
              "    const criadoEmAtualizado = new Date(json.criadoEm).getTime();",
              "    const atualizadoEm = new Date(json.atualizadoEm).getTime();",
              "    pm.expect(Number.isNaN(criadoEmOriginal)).to.eql(false);",
              "    pm.expect(Number.isNaN(criadoEmAtualizado)).to.eql(false);",
              "    pm.expect(Number.isNaN(atualizadoEm)).to.eql(false);",
              "    pm.expect(criadoEmAtualizado).to.eql(criadoEmOriginal);",
              "    pm.expect(atualizadoEm).to.be.at.least(criadoEmAtualizado);",
              "});"
            ]
          }
        }
      ],
