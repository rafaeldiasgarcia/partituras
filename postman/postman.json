    {
      "name": "Criar partitura - sucesso",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const unique = Date.now().toString();",
              "pm.variables.set('tituloCriacao', `Sonata Teste ${unique}`);",
              "pm.variables.set('compositorCriacao', `Mozart ${unique}`);",
              "pm.variables.set('instrumentoCriacao', 'Piano');",
              "pm.variables.set('nivelCriacao', 'INTERMEDIARIO');",
              "pm.variables.set('tomCriacao', 'C');",
              "pm.variables.set('arquivoUrlCriacao', `https://exemplo.com/partitura-${unique}.pdf`);",
              "pm.variables.set('observacoesCriacao', `Observação ${unique}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('Retorna id válido', function () {",
              "    pm.expect(json.id).to.match(/^[0-9a-fA-F-]{36}$/);",
              "});",
              "",
              "pm.test('Retorna payload criado', function () {",
              "    pm.expect(json.titulo).to.eql(pm.variables.get('tituloCriacao'));",
              "    pm.expect(json.compositor).to.eql(pm.variables.get('compositorCriacao'));",
              "    pm.expect(json.instrumento).to.eql(pm.variables.get('instrumentoCriacao'));",
              "    pm.expect(json.nivel).to.eql(pm.variables.get('nivelCriacao'));",
              "    pm.expect(json.tom).to.eql(pm.variables.get('tomCriacao'));",
              "    pm.expect(json.arquivoUrl).to.eql(pm.variables.get('arquivoUrlCriacao'));",
              "    pm.expect(json.observacoes).to.eql(pm.variables.get('observacoesCriacao'));",
              "});",
              "",
              "pm.test('Retorna timestamps', function () {",
              "    pm.expect(json.criadoEm).to.be.a('string').and.not.empty;",
              "    pm.expect(json.atualizadoEm).to.be.a('string').and.not.empty;",
              "});",
              "",
              "pm.test('Retorna header Location', function () {",
              "    const location = pm.response.headers.get('Location');",
              "    pm.expect(location).to.include('/partituras/');",
              "});",
              "",
              "pm.collectionVariables.set('partituraId', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
